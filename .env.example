# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─── MongoDB Configuration ─────────────────────────────────────────────────────
# Local Docker: mongodb://localhost:27017/banquet-pro-db
# MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/banquet-pro-db
MONGODB_URI="mongodb://localhost:27017/banquet-pro-db"

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Change this to a strong random string in production
JWT_SECRET="banquet-pro-change-this-to-a-strong-secret"

# ─── Server Configuration ──────────────────────────────────────────────────────
SERVER_PORT=5000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
