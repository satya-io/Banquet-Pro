        }
        lines {
          text: "                  <p>\342\200\242 <strong>{language === \'hi\' ? \'\340\244\232\340\244\276\340\244\237 \340\244\270\340\245\215\340\244\237\340\245\211\340\244\262 \340\244\224\340\244\260 \340\244\253\340\245\215\340\244\260\340\245\202\340\244\237:\' : \'Chat Stall & Fruits:\'}</strong> 8:00 PM to 11:30 PM</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <p>\342\200\242 <strong>{language === \'hi\' ? \'\340\244\241\340\244\277\340\244\250\340\244\260 \340\244\254\340\245\201\340\244\253\340\245\207:\' : \'Dinner Buffet:\'}</strong> 9:00 PM to 12:30 AM</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <p className=\"text-[9px] italic mt-1 text-[#c09853]\">\340\244\232\340\244\276\340\244\237 \340\244\270\340\245\215\340\244\237\340\245\211\340\244\262 (\340\244\260\340\244\276\340\244\244 8 \340\244\270\340\245\207 11:30) | \340\244\241\340\244\277\340\244\250\340\244\260 (\340\244\260\340\244\276\340\244\244 9 \340\244\270\340\245\207 12:30)</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
