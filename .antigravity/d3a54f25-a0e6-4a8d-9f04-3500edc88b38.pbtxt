          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            key={item.id}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            type=\"button\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            onClick={() => handleMenuToggle(item.name)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
