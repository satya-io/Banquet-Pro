        }
        lines {
          text: "                              isChecked ? \'bg-[#00288e] border-[#00288e] text-white\' : \'border-gray-300\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            }`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              {isChecked && \'\342\234\223\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
