        target_content: "export const initialCateringItems: CateringItem[] = [\n  {\n    id: \'CAT-001\',\n    name: \'Truffle Mushroom Bruschetta\',\n    category: \'Starter\',\n    description: \'Wild forest mushrooms, truffle oil, toasted sourdough, fresh herbs and micro-greens.\',\n    price: 18.50,\n    isAvailable: true,\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuC48_uvCxzRQkKSGPnVufMdYo4ywtxJ2uvyEjXm52s-69sZKbm9yFPKn3fLfAkzFovSMUzahqTecrr6RnU0YPyVvgIq_AfgjPBALsnAVfoyQLLiEwBv7ab8GULplJlih2PH0JPYAfx3Ua1pUkRSO3mlW3_BHkRHyFveWVgFvCmDYL9N41hHtBjbcxSQMI3kuggQjvVNEVFS2s5au3YL8QSe2E31TLonMUH7AlX5dVHj_H6EosG6N93-_Q\'\n  },\n  {\n    id: \'CAT-002\',\n    name: \'Seared Atlantic Scallops\',\n    category: \'Starter\',\n    description: \'Minted pea pur\303\251e, pancetta soil, lemon emulsion, top-down elegant sear.\',\n    price: 24.00,\n    isAvailable: true,\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuAS6-792Mdz04gvHJvk8ojflNiyShDXsDDDdI_KUd7rWVgSvu7AdtvjQtrKca0znT4GG2UjZGqlLceW54JSHoaqncEgFCWP0NrBy1ADsTOzxY2gkWfRKEAAMbAUziBjW5pNqK3rwfh5uF9wTiiH4tZAIchsXFLcexkV9wGlE3RcI0mVKyPQVtRpTV5IxSUXNikJnCRuMW1AF1oy3sjjZRAZmu98q5AbWHKe2B22rOpX19PA57lHA2bF4w\'\n  },\n  {\n    id: \'CAT-003\',\n    name: \'Artisan Caesar Salad\',\n    category: \'Starter\',\n    description: \'Baby gem, white anchovies, 24-month parmesan, garlic sourdough croutons.\',\n    price: 16.00,\n    isAvailable: false,\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuCFjSnajHNjGVcFqnPO2qrnm9TaMVLL6AyfB6mSUVUWeTGmSClNNQPv6ki9mvxBUUbUXtD_BWArrU6QBvqA-nUBBQDP8Af8NlkyTsLgJVG6N-7j8-uC-v4TYR9oSLkj_VDFcDoq5a25H1bIec-SrW3P6L5e2CobBs_DsCdFZ4OrZE7k_R_tuKfULob0sH-PK743uMJR9GFH2aIPJocef_JMxyuHlaH5wC7ikTIC7xZHcD_iO_zUvg-qkw\'\n  },\n  {\n    id: \'CAT-004\',\n    name: \'Herb-Crusted Rack of Lamb\',\n    category: \'Main Course\',\n    description: \'New Zealand premium lamb, roasted root vegetables, rosemary jus, mint emulsion. A high-contrast presentation