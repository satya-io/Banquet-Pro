        lines {
          text: "                  <p className=\"font-bold text-[#c09853] border-b border-[#fbeed5] pb-0.5 uppercase tracking-wider\">\360\237\222\260 {language === \'hi\' ? \'\340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\225\340\244\276 \340\244\250\340\244\277\340\244\257\340\244\256\' : \'Payment Schedule\'}</p>"
