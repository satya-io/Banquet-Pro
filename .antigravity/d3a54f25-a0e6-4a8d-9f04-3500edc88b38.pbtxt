          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <p className=\"font-bold text-[#c09853] border-b border-[#fbeed5] pb-0.5 uppercase tracking-wider\">\342\232\240\357\270\217 {language === \'hi\' ? \'\340\244\205\340\244\244\340\244\277\340\244\260\340\244\277\340\244\225\340\245\215\340\244\244 \340\244\205\340\244\244\340\244\277\340\244\245\340\244\277 \340\244\224\340\244\260 \340\244\252\340\245\215\340\244\262\340\245\207\340\244\237 \340\244\250\340\244\277\340\244\257\340\244\256\' : \'Extra Gathering & Plates Policy\'}</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
