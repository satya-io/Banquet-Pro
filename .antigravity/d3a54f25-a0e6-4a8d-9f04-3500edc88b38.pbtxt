        }
        lines {
          text: "                const items = categories[catName];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                if (items.length === 0) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
