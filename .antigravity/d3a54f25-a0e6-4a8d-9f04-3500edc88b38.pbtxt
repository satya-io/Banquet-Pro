    instruction: "Implement translations on the LoginScreen component and add an elegant top-right language switcher."
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { Shield, Sparkles, User, Lock, ArrowRight, LogIn, UserCheck, HelpCircle } from \'lucide-react\';\n\ninterface LoginScreenProps {\n  onLogin: (role: \'admin\' | \'sales_agent\') => void;\n}\n\nexport default function LoginScreen({ onLogin }: LoginScreenProps) {\n  const [username, setUsername] = useState(\'admin\');\n  const [password, setPassword] = useState(\'admin123\');\n  const [error, setError] = useState(\'\');\n  const [selectedRole, setSelectedRole] = useState<\'admin\' | \'sales_agent\'>(\'admin\');\n\n  const handleRoleSelect = (role: \'admin\' | \'sales_agent\') => {\n    setSelectedRole(role);\n    if (role === \'admin\') {\n      setUsername(\'admin\');\n      setPassword(\'admin123\');\n    } else {\n      setUsername(\'sales\');\n      setPassword(\'sales123\');\n    }\n    setError(\'\');\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (username === \'admin\' && password === \'admin123\') {\n      onLogin(\'admin\');\n    } else if (username === \'sales\' && password === \'sales123\') {\n      onLogin(\'sales_agent\');\n    } else {\n      setError(\'Invalid username or password. Please try again.\');\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#fbf8ff] flex items-center justify-center p-4 sm:p-6 lg:p-8 font-sans\">\n      <div className=\"w-full max-w-4xl bg-white rounded-3xl shadow-2xl border border-[#e3e1eb] overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[600px] animate-scale-up\">\n        \n        {/* Left Visual Banner (Deep Brand Navy) */}\n        <div className=\"md:col-span-5 bg-[#00288e] p-8 sm:p-12 text-white flex flex-col justify-between relative overflow-hidden\">\n          {/* Abstract circles decoration */}\n          <div className=\"absolute -top-16 -left-16 w-48 h-48 rounded-full bg-white/10 blur-xl\"></div>\n          <div className=\"absolute -bottom-20 -right-20 w-64 h-64 rounded-full bg-white/5 blur-2xl\"></div>\n\n          <div className=\"space-y-4 relative z-10\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1.5 bg-white/10 rounded-full backdrop-blur-md border border-white/20 text-xs font-bold text-[#6cf8bb]\">\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>v1.5 Enterprise Suite</span>\n            </div>\n            \n            <div className=\"flex items-center gap-2.5 mt-4\">\n              <div className=\"w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center border border-white/20\">\n                <span className=\"font-extrabold text-base tracking-wider text-white\">BP</span>\n              </div>\n              <h1 className=\"font-display font-extrabold text-xl tracking-tight\">Banquet Pro</h1>\n            </div>\n          </div>\n\n          <div className=\"space-y-4 relative z-10 my-8\">\n            <h2 className=\"font-display font-bold text-2xl sm:text-3xl leading-tight\">\n              Manage premium spaces with precision.\n            </h2>\n            <p className=\"text-white/80 text-xs leading-relaxed font-medium\">\n              Seamlessly track inquiries, schedule banquets, configure menus, and optimize dynamic workflows from a single unified portal.\n            </p>\n          </div>\n\n          <div className=\"border-t border-white/20 pt-6 text-[10px] text-white/60 font-semibold tracking-wider uppercase relative z-10\">\n            \302\251 2026 Banquet Pro System\n          </div>\n        </div>\n\n        {/* Right Form & Role Select Section */}\n        <div className=\"md:col-span-7 p-8 sm:p-12 flex flex-col justify-center space-y-8\">\n          <div>\n            <h3 className=\"font-display font-extrabold text-2xl text-[#1a1b22] tracking-tight\">\n              Access Banquet Control Center\n            </h3>\n            <p className=\"text-xs text-[#444653] font-semibold mt-1\">\n              Select your role profile below and authenticate to proceed.\n            </p>\n          </div>\n\n          {/* Quick Role Selection Cards */}\n          <div className=\"grid grid-cols-2 gap-4\">\n            {/* Admin Selector Card */}\n            <button\n              type=\"button\"\n              onClick={() => handleRoleSelect(\'admin\')}\n              className={`p-4 rounded-2xl border text-left transition-all duration-200 flex flex-col justify-between h-28 cursor-pointer relative overflow-hidden ${\n                selectedRole === \'admin\'\n                  ? \'border-[#00288e] bg-[#f4f2fc] ring-2 ring-[#00288e]/30 shadow-md\'\n                  : \'border-[#e3e1eb] bg-white hover:bg-[#fbf8ff]\'\n              }`}\n            >\n              <div className=\"flex justify-between items-center w-full\">\n                <div className={`p-2 rounded-xl ${\n                  selectedRole === \'admin\' ? \'bg-[#00288e] text-white\' : \'bg-[#f4f2fc] text-[#00288e]\'\n                }`}>\n                  <Shield className=\"w-4 h-4\" />\n                </div>\n                {selectedRole === \'admin\' && (\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-[#00288e]\"></span>\n                )}\n              </div>\n              <div>\n                <p className=\"text-xs font-bold text-[#1a1b22]\">System Administrator</p>\n                <p className=\"text-[10px] text-[#444653] font-semibold mt-0.5\">Full financial control</p>\n              </div>\n            </button>\n\n            {/* Sales Consultant Selector Card */}\n            <button\n              type=\"button\"\n              onClick={() => handleRoleSelect(\'sales_agent\')}\n              className={`p-4 rounded-2xl border text-left transition-all duration-200 flex flex-col justify-between h-28 cursor-pointer relative overflow-hidden ${\n                selectedRole === \'sales_agent\'\n                  ? \'border-[#00288e] bg-[#f4f2fc] ring-2 ring-[#00288e]/30 shadow-md\'\n                  : \'border-[#e3e1eb] bg-white hover:bg-[#fbf8ff]\'\n              }`}\n            >\n              <div className=\"flex justify-between items-center w-full\">\n                <div className={`p-2 rounded-xl ${\n                  selectedRole === \'sales_agent\' ? \'bg-[#00288e] text-white\' : \'bg-[#f4f2fc] text-[#00288e]\'\n                }`}>\n                  <UserCheck className=\"w-4 h-4\" />\n                </div>\n                {selectedRole === \'sales_agent\' && (\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-[#00288e]\"></span>\n                )}\n              </div>\n              <div>\n                <p className=\"text-xs font-bold text-[#1a1b22]\">Sales Consultant</p>\n                <p className=\"text-[10px] text-[#444653] font-semibold mt-0.5\">Schedules & calendar only</p>\n              </div>\n            </button>\n          </div>\n\n          {/* Login Form */}\n          <form onSubmit={handleSubmit} className=\"space-y-4 text-xs font-semibold\">\n            {error && (\n              <div className=\"bg-[#ffdad6] text-[#ba1a1a] p-3 rounded-xl border border-[#ffdad6] text-xs font-bold animate-pulse\">\n                {error}\n              </div>\n            )}\n\n            <div className=\"space-y-1\">\n              <label className=\"text-[#444653] block uppercase tracking-wider\">Username</label>\n              <div className=\"relative\">\n                <User className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#444653]/60\" />\n                <input\n                  type=\"text\"\n                  required\n                  value={username}\n                  onChange={(e) => setUsername(e.target.value)}\n                  className=\"w-full bg-[#f4f2fc] border border-[#c4c5d5] rounded-xl pl-10 pr-3 py-2.5 text-sm text-[#1a1b22] focus:outline-none focus:ring-2 focus:ring-[#00288e] focus:border-transparent transition-all\"\n                  placeholder=\"Enter username\"\n                />\n              </div>\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-[#444653] block uppercase tracking-wider\">Security Password</label>\n              <div className=\"relative\">\n                <Lock className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#444653]/60\" />\n                <input\n                  type=\"password\"\n                  required\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  className=\"w-full bg-[#f4f2fc] border border-[#c4c5d5] rounded-xl pl-10 pr-3 py-2.5 text-sm text-[#1a1b22] focus:outline-none focus:ring-2 focus:ring-[#00288e] focus:border-transparent transition-all\"\n                  placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                />\n              </div>\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-3 bg-[#00288e] text-white text-sm font-bold rounded-xl hover:bg-[#1e40af] hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2 shadow-md cursor-pointer mt-6\"\n            >\n              <LogIn className=\"w-4 h-4\" />\n              <span>Sign In with Secure Key</span>\n            </button>\n          </form>\n\n          {/* Quick Info footer */}\n          <div className=\"bg-[#f4f2fc]/50 p-4 rounded-xl border border-[#eeedf7] flex items-start gap-3\">\n            <HelpCircle className=\"w-4 h-4 text-[#00288e] shrink-0 mt-0.5\" />\n            <div className=\"text-[10.5px] text-[#444653] leading-relaxed\">\n              <span className=\"font-bold text-[#1a1b22]\">Demo Authentication Keys:</span>\n              <br />\n              \342\200\242 Admin: <code className=\"font-mono bg-white px-1 py-0.5 rounded border border-[#c4c5d5]/50 font-bold text-[#00288e]\">admin</code> / <code className=\"font-mono bg-white px-1 py-0.5 rounded border border-[#c4c5d5]/50 font-bold text-[#00288e]\">admin123</code>\n              <br />\n              \342\200\242 Sales Agent: <code className=\"font-mono bg-white px-1 py-0.5 rounded border border-[#c4c5d5]/50 font-bold text-[#00288e]\">sales</code> / <code className=\"font-mono bg-white px-1 py-0.5 rounded border border-[#c4c5d5]/50 font-bold text-[#00288e]\">sales123</code>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}"
        replacement_content: "import React, { useState } from \'react\';\nimport { Shield, Sparkles, User, Lock, ArrowRight, LogIn, UserCheck, HelpCircle, Languages } from \'lucide-react\';\nimport { Language, translations } from \'../translations\';\n\ninterface LoginScreenProps {\n  onLogin: (role: \'admin\' | \'sales_agent\') => void;\n  language: Language;\n  onLanguageChange: (lang: Language) => void;\n}\n\nexport default function LoginScreen({ onLogin, language, onLanguageChange }: LoginScreenProps) {\n  const [username, setUsername] = useState(\'admin\');\n  const [password, setPassword] = useState(\'admin123\');\n  const [error, setError] = useState(\'\');\n  const [selectedRole, setSelectedRole] = useState<\'admin\' | \'sales_agent\'>(\'admin\');\n\n  const t = translations[language];\n\n  const handleRoleSelect = (role: \'admin\' | \'sales_agent\') => {\n    setSelectedRole(role);\n    if (role === \'admin\') {\n      setUsername(\'admin\');\n      setPassword(\'admin123\');\n    } else {\n      setUsername(\'sales\');\n      setPassword(\'sales123\');\n    }\n    setError(\'\');\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (username === \'admin\' && password === \'admin123\') {\n      onLogin(\'admin\');\n    } else if (username === \'sales\' && password === \'sales123\') {\n      onLogin(\'sales_agent\');\n    } else {\n      setError(language === \'en\' ? \'Invalid username or password. Please try again.\' : \'\340\244\227\340\244\262\340\244\244 \340\244\257\340\245\202\340\244\234\340\244\274\340\244\260\340\244\250\340\245\207\340\244\256 \340\244\257\340\244\276 \340\244\252\340\244\276\340\244\270\340\244\265\340\244\260\340\245\215\340\244\241\340\245\244 \340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\252\340\245\201\340\244\250\340\244\203 \340\244\252\340\245\215\340\244\260\340\244\257\340\244\276\340\244\270 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\');\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#fbf8ff] flex items-center justify-center p-4 sm:p-6 lg:p-8 font-sans\">\n      <div className=\"w-full max-w-4xl bg-white rounded-3xl shadow-2xl border border-[#e3e1eb] overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[600px] animate-scale-up\">\n        \n        {/* Left Visual Banner (Deep Brand Navy) */}\n        <div className=\"md:col-span-5 bg-[#00288e] p-8 sm:p-12 text-white flex flex-col justify-between relative overflow-hidden\">\n          {/* Abstract circles decoration */}\n          <div className=\"absolute -top-16 -left-16 w-48 h-48 rounded-full bg-white/10 blur-xl\"></div>\n          <div className=\"absolute -bottom-20 -right-20 w-64 h-64 rounded-full bg-white/5 blur-2xl\"></div>\n\n          <div className=\"space-y-4 relative z-10\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1.5 bg-white/10 rounded-full backdrop-blur-md border border-white/20 text-xs font-bold text-[#6cf8bb]\">\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>v1.5 Enterprise Suite</span>\n            </div>\n            \n            <div className=\"flex items-center gap-2.5 mt-4\">\n              <div className=\"w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center border border-white/20\">\n                <span className=\"font-extrabold text-base tracking-wider text-white\">BP</span>\n              </div>\n              <h1 className=\"font-display font-extrabold text-xl tracking-tight\">{t.brandTitle}</h1>\n            </div>\n          </div>\n\n          <div className=\"space-y-4 relative z-10 my-8\">\n            <h2 className=\"font-display font-bold text-2xl sm:text-3xl leading-tight\">\n              {t.brandSlogan}\n            </h2>\n            <p className=\"text-white/80 text-xs leading-relaxed font-medium\">\n              {t.brandDesc}\n            </p>\n          </div>\n\n          <div className=\"border-t border-white/20 pt-6 text-[10px] text-white/60 font-semibold tracking-wider uppercase relative z-10\">\n            \302\251 2026 {t.brandTitle} System\n          </div>\n        </div>\n\n        {/* Right Form & Role Select Section */}\n        <div className=\"md:col-span-7 p-8 sm:p-12 flex flex-col justify-center space-y-6 relative\">\n          \n          {/* Top Right Language Switcher on Login page */}\n          <div className=\"absolute top-6 right-8 flex items-center gap-1.5 bg-[#f4f2fc] border border-[#c4c5d5] rounded-xl px-3 py-1.5 shadow-xs\">\n            <Languages className=\"w-4 h-4 text-[#00288e]\" />\n            <select\n              value={language}\n              onChange={(e) => onLanguageChange(e.target.value as Language)}\n              className=\"bg-transparent border-none text-xs font-bold text-[#1a1b22] focus:outline-none cursor-pointer\"\n            >\n              <option value=\"en\">\360\237\207\254\360\237\207\247 English</option>\n              <option value=\"hi\">\360\237\207\256\360\237\207\263 \340\244\271\340\244\277\340\244\250\340\245\215\340\244\246\340\245\200</option>\n            </select>\n          </div>\n\n          <div className=\"pt-4\">\n            <h3 className=\"font-display font-extrabold text-2xl text-[#1a1b22] tracking-tight\">\n              {t.loginTitle}\n            </h3>\n            <p className=\"text-xs text-[#444653] font-semibold mt-1\">\n              {t.loginSubtitle}\n            </p>\n          </div>\n\n          {/* Quick Role Selection Cards */}\n          <div className=\"grid grid-cols-2 gap-4\">\n            {/* Admin Selector Card */}\n            <button\n              type=\"button\"\n              onClick={() => handleRoleSelect(\'admin\')}\n              className={`p-4 rounded-2xl border text-left transition-all duration-200 flex flex-col justify-between h-28 cursor-pointer relative overflow-hidden ${\n                selectedRole === \'admin\'\n                  ? \'border-[#00288e] bg-[#f4f2fc] ring-2 ring-[#00288e]/30 shadow-md\'\n                  : \'border-[#e3e1eb] bg-white hover:bg-[#fbf8ff]\'\n              }`}\n            >\n              <div className=\"flex justify-between items-center w-full\">\n                <div className={`p-2 rounded-xl ${\n                  selectedRole === \'admin\' ? \'bg-[#00288e] text-white\' : \'bg-[#f4f2fc] text-[#00288e]\'\n                }`}>\n                  <Shield className=\"w-4 h-4\" />\n                </div>\n                {selectedRole === \'admin\' && (\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-[#00288e]\"></span>\n                )}\n              </div>\n              <div>\n                <p className=\"text-xs font-bold text-[#1a1b22]\">{t.adminRoleTitle}</p>\n                <p className=\"text-[10px] text-[#444653] font-semibold mt-0.5\">{t.adminRoleSubtitle}</p>\n              </div>\n            </button>\n\n            {/* Sales Consultant Selector Card */}\n            <button\n              type=\"button\"\n              onClick={() => handleRoleSelect(\'sales_agent\')}\n              className={`p-4 rounded-2xl border text-left transition-all duration-200 flex flex-col justify-between h-28 cursor-pointer relative overflow-hidden ${\n                selectedRole === \'sales_agent\'\n                  ? \'border-[#00288e] bg-[#f4f2fc] ring-2 ring-[#00288e]/30 shadow-md\'\n                  : \'border-[#e3e1eb] bg-white hover:bg-[#fbf8ff]\'\n              }`}\n            >\n              <div className=\"flex justify-between items-center w-full\">\n                <div className={`p-2 rounded-xl ${\n                  selectedRole === \'sales_agent\' ? \'bg-[#00288e] text-white\' : \'bg-[#f4f2fc] text-[#00288e]\'\n                }`}>\n                  <UserCheck className=\"w-4 h-4\" />\n                </div>\n                {selectedRole === \'sales_agent\' && (\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-[#00288e]\"></span>\n                )}\n              </div>\n              <div>\n                <p className=\"text-xs font-bold text-[#1a1b22]\">{t.salesRoleTitle}</p>\n                <p className=\"text-[10px] text-[#444653] font-semibold mt-0.5\">{t.salesRoleSubtitle}</p>\n              </div>\n            </button>\n          </div>\n\n          {/* Login Form */}\n          <form onSubmit={handleSubmit} className=\"space-y-4 text-xs font-semibold\">\n            {error && (\n              <div className=\"bg-[#ffdad6] text-[#ba1a1a] p-3 rounded-xl border border-[#ffdad6] text-xs font-bold animate-pulse\">\n                {error}\n              </div>\n            )}\n\n            <div className=\"space-y-1\">\n              <label className=\"text-[#444653] block uppercase tracking-wider\">{t.usernameLabel}</label>\n              <div className=\"relative\">\n                <User className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#444653]/60\" />\n                <input\n                  type=\"text\"\n                  required\n                  value={username}\n                  onChange={(e) => setUsername(e.target.value)}\n                  className=\"w-full bg-[#f4f2fc] border border-[#c4c5d5] rounded-xl pl-10 pr-3 py-2.5 text-sm text-[#1a1b22] focus:outline-none focus:ring-2 focus:ring-[#00288e] focus:border-transparent transition-all\"\n                  placeholder={language === \'en\' ? \'Enter username\' : \'\340\244\257\340\245\202\340\244\234\340\244\274\340\244\260\340\244\250\340\245\207\340\244\256 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\'}\n                />\n              </div>\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-[#444653] block uppercase tracking-wider\">{t.passwordLabel}</label>\n              <div className=\"relative\">\n                <Lock className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#444653]/60\" />\n                <input\n                  type=\"password\"\n                  required\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  className=\"w-full bg-[#f4f2fc] border border-[#c4c5d5] rounded-xl pl-10 pr-3 py-2.5 text-sm text-[#1a1b22] focus:outline-none focus:ring-2 focus:ring-[#00288e] focus:border-transparent transition-all\"\n                  placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                />\n              </div>\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-3 bg-[#00288e] text-white text-sm font-bold rounded-xl hover:bg-[#1e40af] hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2 shadow-md cursor-pointer mt-6\"\n            >\n              <LogIn className=\"w-4 h-4\" />\n              <span>{t.signInButton}</span>\n            </button>\n          </form>\n\n          {/* Quick Info footer */}\n          <div className=\"bg-[#f4f2fc]/50 p-4 rounded-xl border border-[#eeedf7] flex items-start gap-3\">\n            <HelpCircle className=\"w-4 h-4 text-[#00288e] shrink-0 mt-0.5\" />\n            <div className=\"text-[10.5px] text-[#444653] leading-relaxed\">\n              <span className=\"font-bold text-[#1a1b22]\">{t.demoKeys}:</span>\n              <br />\n              \342\200\242 {t.adminRoleTitle}: <code className=\"font-mono bg-white px-1 py-0.5 rounded border border-[#c4c5d5]/50 font-bold text-[#00288e]\">admin</code> / <code className=\"font-mono bg-white px-1 py-0.5 rounded border border-[#c4c5d5]/50 font-bold text-[#00288e]\">admin123</code>\n              <br />\n              \342\200\242 {t.salesRoleTitle}: <code className=\"font-mono bg-white px-1 py-0.5 rounded border border-[#c4c5d5]/50 font-bold text-[#00288e]\">sales</code> / <code className=\"font-mono bg-white px-1 py-0.5 rounded border border-[#c4c5d5]/50 font-bold text-[#00288e]\">sales123</code>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
