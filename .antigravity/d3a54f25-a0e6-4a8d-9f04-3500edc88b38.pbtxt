  file_change {
    absolute_path_uri: "file:///src/components/Sidebar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { LayoutDashboard, Inbox, CalendarCheck, Calendar, ChefHat, Settings, Sparkles } from \'lucide-react\';\nimport { ActiveTab } from \'../types\';\n\ninterface SidebarProps {\n  activeTab: ActiveTab;\n  onTabChange: (tab: ActiveTab) => void;\n  adminName: string;\n  adminRole: string;\n  adminAvatar: string;\n}\n\nexport default function Sidebar({\n  activeTab,\n  onTabChange,\n  adminName,\n  adminRole,\n  adminAvatar\n}: SidebarProps) {\n  const menuItems = [\n    { id: \'dashboard\' as ActiveTab, label: \'Dashboard\', icon: LayoutDashboard },\n    { id: \'enquiries\' as ActiveTab, label: \'Enquiries\', icon: Inbox, badge: \'8 New\' },\n    { id: \'bookings\' as ActiveTab, label: \'Bookings\', icon: CalendarCheck },\n    { id: \'calendar\' as ActiveTab, label: \'Calendar\', icon: Calendar },\n    { id: \'menu\' as ActiveTab, label: \'Menu\', icon: ChefHat },\n    { id: \'settings\' as ActiveTab, label: \'Settings\', icon: Settings }\n  ];\n\n  return (\n    <aside className=\"hidden lg:flex flex-col h-screen w-64 fixed left-0 top-0 bg-white border-r border-[#e3e1eb] z-40 py-6\">\n      {/* Brand Header */}\n      <div className=\"px-6 mb-8 flex items-center gap-3\">\n        <div className=\"w-10 h-10 rounded-xl bg-[#00288e]/10 flex items-center justify-center text-[#00288e]\">\n          <svg className=\"w-6 h-6\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M20 2C10.0589 2 2 10.0589 2 20C2 29.9411 10.0589 38 20 38C29.9411 38 38 29.9411 38 20C38 10.0589 29.9411 2 20 2ZM20 34C12.268 34 6 27.732 6 20C6 12.268 12.268 6 20 6C27.732 6 34 12.268 34 20C34 27.732 27.732 34 20 34Z\" fill=\"currentColor\"/>\n            <path d=\"M26.2929 15.2929L19 22.5858L15.7071 19.2929C15.3166 18.9024 14.6834 18.9024 14.2929 19.2929C13.9024 19.6834 13.9024 20.3166 14.2929 20.7071L18.2929 24.7071C18.6834 25.0976 19.3166 25.0976 19.7071 24.7071L27.7071 16.7071C28.0976 16.3166 28.0976 15.6834 27.7071 15.2929C27.3166 14.9024 26.6834 14.9024 26.2929 15.2929Z\" fill=\"currentColor\"/>\n          </svg>\n        </div>\n        <div>\n          <h1 className=\"font-sans font-bold text-lg text-[#00288e] tracking-tight leading-none\">Banquet Pro</h1>\n          <p className=\"text-[10px] font-sans font-semibold uppercase tracking-widest text-[#444653]/70 mt-1\">Premium Management</p>\n        </div>\n      </div>\n\n      {/* Navigation Links */}\n      <nav className=\"flex-1 px-3 space-y-1\">\n        {menuItems.map((item) => {\n          const IconComponent = item.icon;\n          const isActive = activeTab === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => onTabChange(item.id)}\n              className={`w-full flex items-center justify-between px-4 py-3 rounded-xl transition-all duration-150 group font-sans text-sm ${\n                isActive\n                  ? \'text-[#00288e] font-bold border-r-4 border-[#00288e] bg-[#f4f2fc]\'\n                  : \'text-[#444653] hover:text-[#1a1b22] hover:bg-[#eeedf7]\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <IconComponent className={`w-5 h-5 ${isActive ? \'text-[#00288e]\' : \'text-[#444653] group-hover:text-[#1a1b22]\'}`} />\n                <span>{item.label}</span>\n              </div>\n              {item.badge && (\n                <span className=\"text-[10px] font-semibold px-2 py-0.5 rounded bg-[#e3e1eb] text-[#1a1b22]\">\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* Trial / Promo Card */}\n      <div className=\"px-4 mb-4\">\n        <div className=\"p-4 bg-[#dde1ff] text-[#001453] rounded-2xl flex flex-col gap-3 border border-[#c4c5d5]/30\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-[#173bab]\" />\n            <p className=\"text-xs font-semibold font-sans\">Trial ends in 12 days</p>\n          </div>\n          <button className=\"w-full bg-[#00288e] text-white py-2 rounded-xl text-xs font-semibold hover:bg-[#1e40af] hover:scale-[1.02] active:scale-[0.98] transition-all shadow-sm\">\n            Upgrade Plan\n          </button>\n        </div>\n      </div>\n\n      {/* User Profile Section at Bottom */}\n      <div className=\"px-4 pt-4 border-t border-[#e3e1eb]\">\n        <div className=\"flex items-center gap-3 p-2 bg-[#f4f2fc] rounded-2xl border border-[#eeedf7]/60\">\n          <div className=\"w-10 h-10 rounded-full bg-[#dde1ff] flex items-center justify-center text-[#00288e] overflow-hidden border border-[#c4c5d5]/40\">\n            {adminAvatar ? (\n              <img src={adminAvatar} alt={adminName} className=\"w-full h-full object-cover\" />\n            ) : (\n              <span className=\"font-bold text-sm\">\n                {adminName.split(\' \').map(n => n[0]).join(\'\')}\n              </span>\n            )}\n          </div>\n          <div className=\"flex-1 min-w-0\">\n            <p className=\"font-sans font-bold text-sm text-[#1a1b22] truncate\">{adminName}</p>\n            <p className=\"text-[10px] text-[#444653] uppercase font-semibold tracking-wider truncate\">{adminRole}</p>\n          </div>\n        </div>\n      </div>\n    </aside>\n  );\n}\n"
    }
