    replacement_infos {
      original_chunk {
        target_content: "  // Active Enquiry selection in panel\n  const [selectedEnquiry, setSelectedEnquiry] = useState<Enquiry | null>(null);\n\n  // Active Admin Details Lookup"
        replacement_content: "  // Active Enquiry selection in panel\n  const [selectedEnquiry, setSelectedEnquiry] = useState<Enquiry | null>(null);\n\n  // User Role State\n  const [userRole, setUserRole] = useState<\'admin\' | \'sales_agent\' | null>(() => {\n    return (localStorage.getItem(\'userRole\') as \'admin\' | \'sales_agent\') || null;\n  });\n\n  const handleLogin = (role: \'admin\' | \'sales_agent\') => {\n    setUserRole(role);\n    localStorage.setItem(\'userRole\', role);\n    if (role === \'sales_agent\') {\n      setActiveTab(\'bookings\');\n    } else {\n      setActiveTab(\'dashboard\');\n    }\n  };\n\n  const handleLogout = () => {\n    setUserRole(null);\n    localStorage.removeItem(\'userRole\');\n  };\n\n  // Active Admin Details Lookup"
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "      case \'bookings\':\n        return (\n          <BookingsView \n            searchQuery={searchQuery}\n            bookings={bookings}\n            onAddBooking={handleAddBooking}\n            onUpdateBooking={handleUpdateBooking}\n            onDeleteBooking={handleDeleteBooking}\n            onOpenNewBookingDrawer={() => {\n              setPrefillEnquiry(null);\n              setNewBookingOpen(true);\n            }}\n          />\n        );\n      case \'calendar\':\n        return (\n          <CalendarView \n            searchQuery={searchQuery}\n            bookings={bookings}\n            enquiries={enquiries}\n            onOpenNewBookingDrawer={() => {\n              setPrefillEnquiry(null);\n              setNewBookingOpen(true);\n            }}\n          />\n        );"
        replacement_content: "      case \'bookings\':\n        return (\n          <BookingsView \n            searchQuery={searchQuery}\n            bookings={bookings}\n            onAddBooking={handleAddBooking}\n            onUpdateBooking={handleUpdateBooking}\n            onDeleteBooking={handleDeleteBooking}\n            onOpenNewBookingDrawer={() => {\n              setPrefillEnquiry(null);\n              setNewBookingOpen(true);\n            }}\n            role={userRole || \'admin\'}\n          />\n        );\n      case \'calendar\':\n        return (\n          <CalendarView \n            searchQuery={searchQuery}\n            bookings={bookings}\n            enquiries={enquiries}\n            onOpenNewBookingDrawer={() => {\n              setPrefillEnquiry(null);\n              setNewBookingOpen(true);\n            }}\n            role={userRole || \'admin\'}\n          />\n        );"
      }
      num_matches: 1
    }
    replacement_infos {
