        }
        lines {
          text: "                  <p>\342\200\242 <strong>{language === \'hi\' ? \'\340\244\205\340\244\227\340\245\215\340\244\260\340\244\277\340\244\256 (Advance):\' : \'Advance:\'}</strong> 50% required at booking time.</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <p>\342\200\242 <strong>{language === \'hi\' ? \'\340\244\266\340\245\207\340\244\267 (Balance):\' : \'Balance:\'}</strong> charged at end of programme.</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <p className=\"text-[9px] italic mt-1 text-[#c09853]\">50% \340\244\254\340\245\201\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\225\340\245\207 \340\244\270\340\244\256\340\244\257 | \340\244\266\340\245\207\340\244\267 \340\244\260\340\244\276\340\244\266\340\244\277 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\340\244\225\340\245\215\340\244\260\340\244\256 \340\244\225\340\245\207 \340\244\205\340\244\202\340\244\244 \340\244\256\340\245\207\340\244\202</p>"
