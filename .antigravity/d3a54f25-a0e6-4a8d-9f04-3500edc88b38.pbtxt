        target_content: "              </div>\n            )}\n          </form>"
        replacement_content: "              </div>\n            )}\n\n            {/* Terms & Conditions Section */}\n            <div className=\"mt-4 bg-[#fcf8e3] border border-[#fbeed5] rounded-2xl p-4 space-y-3.5\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"text-sm font-bold text-[#c09853] flex items-center gap-1.5 uppercase tracking-wide\">\n                  <FileText className=\"w-4 h-4 text-[#c09853]\" />\n                  <span>{language === \'hi\' ? \'\340\244\250\340\244\277\340\244\257\340\244\256 \340\244\224\340\244\260 \340\244\266\340\244\260\340\245\215\340\244\244\340\245\207\340\244\202 (Terms & Conditions)\' : \'Terms & Conditions\'}</span>\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={handleCopyTerms}\n                  className=\"flex items-center gap-1.5 text-[10px] font-bold bg-white text-[#c09853] hover:bg-[#faf4d3] border border-[#fbeed5] rounded-xl px-2.5 py-1.5 cursor-pointer transition-all\"\n                >\n                  {copiedTerms ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-green-600\" />\n                      <span className=\"text-green-600\">{language === \'hi\' ? \'\340\244\225\340\245\211\340\244\252\340\245\200 \340\244\271\340\245\213 \340\244\227\340\244\257\340\244\276!\' : \'Copied!\'}</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      <span>{language === \'hi\' ? \'\340\244\265\340\245\215\340\244\271\340\244\276\340\244\237\340\245\215\340\244\270\340\244\217\340\244\252 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\225\340\245\211\340\244\252\340\245\200 \340\244\225\340\244\260\340\245\207\340\244\202\' : \'Copy to WhatsApp\'}</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-[10px] leading-relaxed text-[#8a6d3b] font-semibold\">\n                <div className=\"bg-white/80 p-3 rounded-xl border border-[#fbeed5]/60 space-y-1\">\n                  <p className=\"font-bold text-[#c09853] border-b border-[#fbeed5] pb-0.5 uppercase tracking-wider\">\342\217\261 {language === \'hi\' ? \'\340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\340\244\225\340\245\215\340\244\260\340\244\256 \340\244\225\340\244\276 \340\244\270\340\244\256\340\244\257\' : \'Program Timings\'}</p>\n                  <p>\342\200\242 <strong>{language === \'hi\' ? \'\340\244\232\340\244\276\340\244\237 \340\244\270\340\245\215\340\244\237\340\245\211\340\244\262 \340\244\224\340\244\260 \340\244\253\340\245\215\340\244\260\340\245\202\340\244\237:\' : \'Chat Stall & Fruits:\'}</strong> 8:00 PM to 11:30 PM</p>\n                  <p>\342\200\242 <strong>{language === \'hi\' ? \'\340\244\241\340\244\277\340\244\250\340\244\260 \340\244\254\340\245\201\340\244\253\340\245\207:\' : \'Dinner Buffet:\'}</strong> 9:00 PM to 12:30 AM</p>\n                  <p className=\"text-[9px] italic mt-1 text-[#c09853]\">\340\244\232\340\244\276\340\244\237 \340\244\270\340\245\215\340\244\237\340\245\211\340\244\262 (\340\244\260\340\244\276\340\244\244 8 \340\244\270\340\245\207 11:30) | \340\244\241\340\244\277\340\244\250\340\244\260 (\340\244\260\340\244\276\340\244\244 9 \340\244\270\340\245\207 12:30)</p>\n                </div>\n\n                <div className=\"bg-white/80 p-3 rounded-xl border border-[#fbeed5]/60 space-y-1\">\n                  <p className=\"font-bold text-[#c09853] border-b border-[#fbeed5] pb-0.5 uppercase tracking-wider\">\360\237\222\260 {language === \'hi\' ? \'\340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\225\340\244\276 \340\244\250\340\244\277\340\244\257\340\244\256\' : \'Payment Schedule\'}</p>\n                  <p>\342\200\242 <strong>{language === \'hi\' ? \'\340\244\205\340\244\227\340\245\215\340\244\260\340\244\277\340\244\256 (Advance):\' : \'Advance:\'}</strong> 50% required at booking time.</p>\n                  <p>\342\200\242 <strong>{language === \'hi\' ? \'\340\244\266\340\245\207\340\244\267 (Balance):\' : \'Balance:\'}</strong> charged at end of programme.</p>\n                  <p className=\"text-[9px] italic mt-1 text-[#c09853]\">50% \340\244\254\340\245\201\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\225\340\245\207 \340\244\270\340\244\256\340\244\257 | \340\244\266\340\245\207\340\244\267 \340\244\260\340\244\276\340\244\266\340\244\277 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\340\244\225\340\245\215\340\244\260\340\244\256 \340\244\225\340\245\207 \340\244\205\340\244\202\340\244\244 \340\244\256\340\245\207\340\244\202</p>\n                </div>\n\n                <div className=\"bg-white/80 p-3 rounded-xl border border-[#fbeed5]/60 col-span-1 sm:col-span-2 space-y-1\">\n                  <p className=\"font-bold text-[#c09853] border-b border-[#fbeed5] pb-0.5 uppercase tracking-wider\">\342\232\240\357\270\217 {language === \'hi\' ? \'\340\244\205\340\244\244\340\244\277\340\244\260\340\244\277\340\244\225\340\245\215\340\244\244 \340\244\205\340\244\244\340\244\277\340\244\245\340\244\277 \340\244\224\340\244\260 \340\244\252\340\245\215\340\244\262\340\245\207\340\244\237 \340\244\250\340\244\277\340\244\257\340\244\256\' : \'Extra Gathering & Plates Policy\'}</p>\n                  <p>\342\200\242 No responsibility for extra gathering beyond agreed pax.</p>\n                  <p>\342\200\242 All extra plates must be logged and paid by host.</p>\n                  <p className=\"text-[9px] italic mt-1 text-[#c09853]\">\340\244\205\340\244\244\340\244\277\340\244\260\340\244\277\340\244\225\340\245\215\340\244\244 \340\244\255\340\245\200\340\244\241\340\244\274 \340\244\225\340\245\200 \340\244\234\340\244\277\340\244\256\340\245\215\340\244\256\340\245\207\340\244\246\340\244\276\340\244\260\340\245\200 \340\244\250\340\244\271\340\245\200\340\244\202 | \340\244\217\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237\340\245\215\340\244\260\340\244\276 \340\244\252\340\245\215\340\244\262\340\245\207\340\244\237 \340\244\225\340\244\276 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\256\340\245\207\340\244\234\340\244\254\340\244\276\340\244\250 \340\244\225\340\245\213 \340\244\225\340\244\260\340\244\250\340\244\276 \340\244\271\340\245\213\340\244\227\340\244\276</p>\n                </div>\n              </div>\n\n              <label className=\"flex items-center gap-2 pt-2 border-t border-[#fbeed5] cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={termsAcknowledged}\n                  onChange={(e) => setTermsAcknowledged(e.target.checked)}\n                  className=\"rounded text-[#00288e] focus:ring-[#00288e] cursor-pointer\"\n                />\n                <span className=\"text-[11px] text-[#8a6d3b] font-bold\">\n                  {language === \'hi\' \n                    ? \'\340\244\256\340\245\210\340\244\202\340\244\250\340\245\207 \340\244\227\340\245\215\340\244\260\340\244\276\340\244\271\340\244\225 \340\244\225\340\245\213 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\340\244\225\340\245\215\340\244\260\340\244\256 \340\244\225\340\245\207 \340\244\270\340\244\256\340\244\257, 50% \340\244\205\340\244\227\340\245\215\340\244\260\340\244\277\340\244\256 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\224\340\244\260 \340\244\205\340\244\244\340\244\277\340\244\260\340\244\277\340\244\225\340\245\215\340\244\244 \340\244\252\340\245\215\340\244\262\340\245\207\340\244\237 \340\244\225\340\245\207 \340\244\250\340\244\277\340\244\257\340\244\256\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\254\340\244\276\340\244\260\340\245\207 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\202\340\244\232\340\244\277\340\244\244 \340\244\225\340\244\260 \340\244\246\340\244\277\340\244\257\340\244\276 \340\244\271\340\245\210\340\245\244\' \n                    : \'I have informed the customer about program timings, 50% advance, and extra plate rules.\'\n                  }\n                </span>\n              </label>\n            </div>\n          </form>"
      }
