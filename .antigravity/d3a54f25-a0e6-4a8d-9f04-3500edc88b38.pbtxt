      original_chunk {
        target_content: "export const initialCateringItems: CateringItem[] = [\n  // --- WELCOME DRINKS & MOCKTAILS & JUICES (Beverages) ---\n  {\n    id: \'CAT-VD-01\',\n    name: \'Pan Shake\',\n    category: \'Beverage\',\n    description: \'Refreshing traditional betel leaf flavored creamy sweet shake.\',\n    price: 1.45, // \342\202\271120\n    isAvailable: true,\n    image: \'\',\n    isBestseller: true\n  },\n  {\n    id: \'CAT-VD-02\',\n    name: \'Mango Shake\',\n    category: \'Beverage\',\n    description: \'Rich and creamy shake made with fresh Alphonso mango pulp.\',\n    price: 1.57, // \342\202\271130\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-VD-03\',\n    name: \'Butter Scotch Shake\',\n    category: \'Beverage\',\n    description: \'Sweet, buttery caramelized shake topped with butterscotch crunch.\',\n    price: 1.57, // \342\202\271130\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-VD-04\',\n    name: \'Strawberry Shake\',\n    category: \'Beverage\',\n    description: \'Classic creamy shake with sweet ripe strawberry syrup.\',\n    price: 1.57, // \342\202\271130\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-VD-05\',\n    name: \'Coconut Water\',\n    category: \'Beverage\',\n    description: \'Fresh, hydrating and healthy natural tender coconut water.\',\n    price: 1.80, // \342\202\271150\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-VD-06\',\n    name: \'Fruit Cocktail\',\n    category: \'Beverage\',\n    description: \'Tropical mixed fruit blend with a squeeze of fresh lime.\',\n    price: 1.69, // \342\202\271140\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-VD-07\',\n    name: \'Jaljeera\',\n    category: \'Beverage\',\n    description: \'Zesty Indian summer cooler infused with cumin, mint, and black salt.\',\n    price: 0.96, // \342\202\27180\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-VD-08\',\n    name: \'Pineapple Shake\',\n    category: \'Beverage\',\n    description: \'Tangy and creamy shake blended with real sweet pineapple.\',\n    price: 1.57, // \342\202\271130\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-MC-01\',\n    name: \'Blue Lagoon Mocktail\',\n    category: \'Beverage\',\n    description: \'Vibrant blue cura\303\247ao with lemon soda and crushed ice.\',\n    price: 1.93, // \342\202\271160\n    isAvailable: true,\n    image: \'\',\n    isBestseller: true\n  },\n  {\n    id: \'CAT-MC-02\',\n    name: \'Thai Mojito\',\n    category: \'Beverage\',\n    description: \'Refreshing mojito with a Thai twist of lemongrass and mint.\',\n    price: 1.93, // \342\202\271160\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-MC-03\',\n    name: \'Lemon Soda\',\n    category: \'Beverage\',\n    description: \'Classic sparkling sweet & salty fresh lime soda.\',\n    price: 1.20, // \342\202\271100\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-JC-01\',\n    name: \'Fresh Juice (Seasonal)\',\n    category: \'Beverage\',\n    description: \'Freshly squeezed seasonal fruit juice served chilled.\',\n    price: 1.80, // \342\202\271150\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-JC-02\',\n    name: \'Watermelon Juice\',\n    category: \'Beverage\',\n    description: \'Refreshing cold-pressed pure watermelon juice.\',\n    price: 1.57, // \342\202\271130\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-JC-03\',\n    name: \'Grapes Juice\',\n    category: \'Beverage\',\n    description: \'Sweet and tangy fresh black and green grape extract.\',\n    price: 1.57, // \342\202\271130\n    isAvailable: true,\n    image: \'\'\n  },\n  {\n    id: \'CAT-JC-04\',\n    name: \'Guava Juice\',\n    category: \'Beverage\',\n    description: \'Luscious guava nectar with a hint of red chili powder on the rim.\',\n    price: 1.57, // \342\202\271130\n    isAvailable: true,\n    image: \'\'\n  