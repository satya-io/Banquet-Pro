        lines {
          text: "                  <p className=\"font-bold text-[#c09853] border-b border-[#fbeed5] pb-0.5 uppercase tracking-wider\">\342\217\261 {language === \'hi\' ? \'\340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\340\244\225\340\245\215\340\244\260\340\244\256 \340\244\225\340\244\276 \340\244\270\340\244\256\340\244\257\' : \'Program Timings\'}</p>"
