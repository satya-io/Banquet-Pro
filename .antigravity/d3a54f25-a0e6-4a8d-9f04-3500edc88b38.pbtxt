        lines {
          text: "                  <p className=\"text-[9px] italic mt-1 text-[#c09853]\">\340\244\205\340\244\244\340\244\277\340\244\260\340\244\277\340\244\225\340\245\215\340\244\244 \340\244\255\340\245\200\340\244\241\340\244\274 \340\244\225\340\245\200 \340\244\234\340\244\277\340\244\256\340\245\215\340\244\256\340\245\207\340\244\246\340\244\276\340\244\260\340\245\200 \340\244\250\340\244\271\340\245\200\340\244\202 | \340\244\217\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237\340\245\215\340\244\260\340\244\276 \340\244\252\340\245\215\340\244\262\340\245\207\340\244\237 \340\244\225\340\244\276 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\256\340\245\207\340\244\234\340\244\254\340\244\276\340\244\250 \340\244\225\340\245\213 \340\244\225\340\244\260\340\244\250\340\244\276 \340\244\271\340\245\213\340\244\227\340\244\276</p>"
