          text: "                            className={`flex items-center gap-2 p-2 rounded-lg border text-left transition-all ${"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              isChecked "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
