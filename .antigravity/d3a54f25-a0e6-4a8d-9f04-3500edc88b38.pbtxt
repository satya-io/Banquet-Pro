340\244\252\340\245\202\340\244\233\340\244\244\340\244\276\340\244\233 \340\244\252\340\244\276\340\244\207\340\244\252\340\244\262\340\244\276\340\244\207\340\244\250\',\n    enquiriesSubtitle: \'\340\244\252\340\245\202\340\244\233\340\244\244\340\244\276\340\244\233, \340\244\205\340\244\244\340\244\277\340\244\245\340\244\277 \340\244\265\340\244\277\340\244\266\340\244\277\340\244\267\340\245\215\340\244\237\340\244\244\340\244\276\340\244\223\340\244\202, \340\244\254\340\244\234\340\244\237 \340\244\224\340\244\260 \340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277 \340\244\252\340\244\276\340\244\207\340\244\252\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\225\340\245\213 \340\244\237\340\245\215\340\244\260\340\245\210\340\244\225 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n    newEnquiryBtn: \'\340\244\250\340\244\257\340\244\276 \340\244\262\340\245\200\340\244\241 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\',\n    allStatus: \'\340\244\270\340\244\255\340\245\200 \340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277\340\244\257\340\244\276\340\244\201\',\n    statusNew: \'\340\244\250\340\244\257\340\244\276\',\n    statusNegotiating: \'\340\244\254\340\244\276\340\244\244\340\244\232\340\245\200\340\244\244 \340\244\234\340\244\276\340\244\260\340\245\200\',\n    statusConfirmed: \'\340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 \340\244\225\340\245\200 \340\244\227\340\244\210\',\n    statusLost: \'\340\244\226\340\245\213\340\244\257\340\244\276 \340\244\271\340\245\201\340\244\206\',\n    searchEnquiries: \'\340\244\252\340\245\202\340\244\233\340\244\244\340\244\276\340\244\233 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202...\',\n    enquiryHeader: \'\340\244\252\340\245\202\340\244\233\340\244\244\340\244\276\340\244\233 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\224\340\244\260 \340\244\262\340\245\211\340\244\227\',\n    notesHeader: \'\340\244\254\340\244\276\340\244\244\340\244\232\340\245\200\340\244\244 \340\244\262\340\245\211\340\244\227 \340\244\224\340\244\260 \340\244\250\340\245\213\340\244\237\340\245\215\340\244\270\',\n    addNoteBtn: \'\340\244\250\340\245\213\340\244\237 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\',\n    notePlaceholder: \'\340\244\250\340\244\257\340\244\276 \340\244\265\340\244\276\340\244\260\340\245\215\340\244\244\340\244\276\340\244\262\340\244\276\340\244\252 \340\244\250\340\245\213\340\244\237 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202...\',\n    convertToBookingBtn: \'\340\244\270\340\244\225\340\245\215\340\244\260\340\244\277\340\244\257 \340\244\254\340\245\201\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\256\340\245\207\340\244\202 \340\244\254\340\244\246\340\244\262\340\245\207\340\244\202\',\n    deleteEnquiryBtn: \'\340\244\262\340\245\200\340\244\241 \340\244\271\340\244\237\340\244\276\340\244\217\340\244\202\',\n    paxValue: \'\340\244\205\340\244\244\340\244\277\340\244\245\340\244\277\',\n\n    // Settings\n    settingsTitle: \'\340\244\225\340\244\202\340\244\237\340\245\215\340\244\260\340\245\213\340\244\262 \340\244\270\340\245\207\340\244\202\340\244\237\340\244\260 \340\244\270\340\245\207\340\244\237\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270\',\n    settingsSubtitle: \'\340\244\270\340\245\215\340\244\245\340\244\276\340\244\250 \340\244\270\340\245\200\340\244\256\340\244\276\340\244\217\340\244\202, \340\244\254\340\244\277\340\244\262\340\244\277\340\244\202\340\244\227 \340\244\256\340\244\276\340\244\250\340\244\225 \340\244\224\340\244\260 \340\244\270\340\245\215\340\244\237\340\244\276\340\244\253 \340\244\252\340\245\215\340\244\260\340\245\213\340\244\253\340\244\276\340\244\207\340\244\262 \340\244\225\340\245\211\340\244\250\340\245\215\340\244\253\340\244\274\340\244\277\340\244\227\340\244\260 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n    generalTab: \'\340\244\270\340\244\276\340\244\256\340\244\276\340\244\250\340\245\215\340\244\257 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250 \340\244\270\340\245\207\340\244\237\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270\',\n    staffTab: \'\340\244\270\340\245\215\340\244\237\340\244\276\340\244\253 \340\244\224\340\244\260 \340\244\255\340\245\202\340\244\256\340\244\277\340\244\225\340\244\276\340\244\217\340\244\202 \340\244\250\340\244\277\340\244\257\340\244\202\340\244\244\340\245\215\340\244\260\340\244\243\',\n    spacesTab: \'\340\244\254\340\245\210\340\244\202\340\244\225\340\245\215\340\244\265\340\245\207\340\244\237 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250 (Spaces)\',\n    securityTab: \'\340\244\241\340\245\207\340\244\237\340\244\276\340\244\254\340\245\207\340\244\270 \340\244\224\340\244\260 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',\n    saveSettings: \'\340\244\270\340\245\207\340\244\237\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270 \340\244\270\340\244\271\340\245\207\340\244\234\340\245\207\340\244\202\',\n    activeIdentity: \'\340\244\270\340\244\225\340\245\215\340\244\260\340\244\277\340\244\257 \340\244\270\340\244\244\340\245\215\340\244\260 \340\244\252\340\244\271\340\244\232\340\244\276\340\244\250 (Session)\',\n    changeStaffDesc: \'\340\244\211\340\244\250\340\244\225\340\245\200 \340\244\255\340\245\202\340\244\256\340\244\277\340\244\225\340\244\276 \340\244\224\340\244\260 \340\244\205\340\244\250\340\245\201\340\244\256\340\244\244\340\244\277\340\244\257\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\205\340\244\250\340\245\201\340\244\225\340\244\260\340\244\243 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\250\340\245\200\340\244\232\340\245\207 \340\2